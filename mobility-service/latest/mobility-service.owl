        <skos:broader rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service/sharing-mobility-service"/>
        <skos:definition xml:lang="en">Service providing a trip on a given route to be shared among multiple participants</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service"/>
        <skos:prefLabel xml:lang="en">Ride sharing</skos:prefLabel>
    </owl:NamedIndividual>
    


