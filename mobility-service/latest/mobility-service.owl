        <skos:definition xml:lang="en">Organization that rents vehicles to individuals or businesses on a temporary basis.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service"/>
        <skos:prefLabel xml:lang="en">Rental service</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mobilitydcat-ap/mobility-service/ride-hailing -->


