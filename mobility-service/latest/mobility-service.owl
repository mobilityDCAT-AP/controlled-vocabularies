    <!-- https://w3id.org/mobilitydcat-ap/mobility-service/door-to-door -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mobilitydcat-ap/mobility-service/door-to-door">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service/transport-service"/>
        <skos:definition xml:lang="en">Services picking up and dropping off passengers at specific locations</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service"/>
        <skos:prefLabel xml:lang="en">Door-to-door</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mobilitydcat-ap/mobility-service/fixed-route -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mobilitydcat-ap/mobility-service/fixed-route">
