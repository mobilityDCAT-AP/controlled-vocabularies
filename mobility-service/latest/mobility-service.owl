        <skos:broader rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service/transport-service"/>
        <skos:definition xml:lang="en">Services activated only when requested by users</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service"/>
        <skos:prefLabel xml:lang="en">On-demand</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mobilitydcat-ap/mobility-service/peer-to-peer -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mobilitydcat-ap/mobility-service/peer-to-peer">
