        <skos:broader rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service/sharing-mobility-service"/>
        <skos:definition xml:lang="en">Service for multiple passengers to organise a shared trip</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service"/>
        <skos:prefLabel xml:lang="en">Ride pooling</skos:prefLabel>
    </owl:NamedIndividual>
    


