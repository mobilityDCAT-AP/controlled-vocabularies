        <skos:broader rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service/transport-service"/>
        <skos:definition xml:lang="en">Services with variable routing depending on demand</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-service"/>
        <skos:prefLabel xml:lang="en">Flexible</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mobilitydcat-ap/mobility-service/free-floating-sharing-service -->


