<https://w3id.org/mobilitydcat-ap/transport-mode> a skos:ConceptScheme;
  a owl:Ontology;
  dct:title "Transport Mode"@en;
  dct:description "Controlled vocabulary for the transport modes covered by a dataset."@en;
  dct:creator "Mario Scrocca (Cefriel)"@en, "Peter Lubrich (BASt)"@en;
  dct:publisher "NAPCORE SubWG4.4"@en;
  dct:contributor "Petr Bures (TamTam Research)"@en, "Sara Guerra de Oliveira (University of Maribor)"@en,
    "Ed Ooms (NDW)"@en, "Benjamin Witsch (AustriaTech)"@en, "Christian Rantzow von Huth (Vejdirektoratet)"@en;
  owl:versionInfo "2.0.0"@en;
  owl:versionIRI <https://w3id.org/mobilitydcat-ap/transport-mode/2.0.0>;
  owl:priorVersion <https://w3id.org/mobilitydcat-ap/transport-mode/1.0.0>;
  dct:license <https://creativecommons.org/licenses/by/4.0/>;
  <http://purl.org/ontology/bibo/status> "Draft Controlled Vocabulary"@en;
  skos:hasTopConcept <https://w3id.org/mobilitydcat-ap/transport-mode/road-transport>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/rail-transport>, <https://w3id.org/mobilitydcat-ap/transport-mode/metro-subway-train>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/water-transport>, <https://w3id.org/mobilitydcat-ap/transport-mode/air-transport>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/air>, <https://w3id.org/mobilitydcat-ap/transport-mode/special-transport>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/micromobility>, <https://w3id.org/mobilitydcat-ap/transport-mode/pedestrian>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/other>, <https://w3id.org/mobilitydcat-ap/transport-mode/bike-hire>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/bike-sharing>, <https://w3id.org/mobilitydcat-ap/transport-mode/car-hire>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/car-pooling>, <https://w3id.org/mobilitydcat-ap/transport-mode/car-sharing>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/ride-pooling>, <https://w3id.org/mobilitydcat-ap/transport-mode/taxi> .

<https://w3id.org/mobilitydcat-ap/transport-mode/road-transport> a skos:Concept;
  skos:prefLabel "Road transport"@en;
  skos:definition "Movement of people or goods using vehicles operating on public roads."@en;
  skos:narrower <https://w3id.org/mobilitydcat-ap/transport-mode/car>, <https://w3id.org/mobilitydcat-ap/transport-mode/motorcycle>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/bus>, <https://w3id.org/mobilitydcat-ap/transport-mode/coach>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/truck>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/car> a skos:Concept;
  skos:prefLabel "Car"@en;
  skos:definition "Motor vehicle designed primarily for personal passenger transport"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/road-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/motorcycle> a skos:Concept;
  skos:prefLabel "Motorcycle"@en;
  skos:definition "Two‑wheeled motor vehicle for individual transport"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/road-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/bus> a skos:Concept;
  skos:prefLabel "Bus"@en;
  skos:definition "Road vehicle designed for carrying multiple passengers on fixed or flexible routes"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/road-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/coach> a skos:Concept;
  skos:prefLabel "Coach"@en;
  skos:definition "Comfortable long‑distance bus designed for intercity or touring travel"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/road-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/truck> a skos:Concept;
  skos:prefLabel "Truck"@en;
  skos:definition "Motor vehicle designed for transporting goods or heavy loads"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/road-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/rail-transport> a skos:Concept;
  skos:prefLabel "Rail transport"@en;
  skos:definition "Transport using guided vehicles running on rail tracks"@en;
  skos:narrower <https://w3id.org/mobilitydcat-ap/transport-mode/long-distance-rail>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/regional-and-local-rail>, <https://w3id.org/mobilitydcat-ap/transport-mode/tram-light-rail>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/metro>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/long-distance-rail> a skos:Concept;
  skos:prefLabel "Long-distance rail"@en;
  skos:definition "Rail service covering extended national or international routes"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/rail-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/regional-and-local-rail> a skos:Concept;
  skos:prefLabel "Regional and local rail"@en;
  skos:definition "Rail service covering regional or local routes"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/rail-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/tram-light-rail> a skos:Concept;
  skos:prefLabel "Tram and light rail"@en;
  skos:definition "Street‑level rail vehicle operating in mixed traffic or dedicated lanes"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/rail-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/metro-subway-train> a skos:Concept;
  skos:prefLabel "Metro, Subway train"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/metro>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/metro> a skos:Concept;
  skos:prefLabel "Metro"@en;
  skos:definition "High‑capacity urban rail system operating on segregated tracks"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/rail-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/water-transport> a skos:Concept;
  skos:prefLabel "Water transport"@en;
  skos:definition "Transport using vessels on seas, rivers, or canals"@en;
  skos:narrower <https://w3id.org/mobilitydcat-ap/transport-mode/maritime>, <https://w3id.org/mobilitydcat-ap/transport-mode/inland-waterways>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/shuttle-ferry>, <https://w3id.org/mobilitydcat-ap/transport-mode/water-taxi>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/maritime> a skos:Concept;
  skos:prefLabel "Maritime"@en;
  skos:definition "Maritime including ferry / Transport on seas or coastal waters"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/water-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/inland-waterways> a skos:Concept;
  skos:prefLabel "Inland waterways"@en;
  skos:definition "Transport on rivers, canals, and lakes"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/water-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/shuttle-ferry> a skos:Concept;
  skos:prefLabel "Shuttle ferry"@en;
  skos:definition "Vessel carrying passengers or vehicles across water on scheduled routes"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/water-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/water-taxi> a skos:Concept;
  skos:prefLabel "Water taxi"@en;
  skos:definition "A water taxi is a small passenger vessel that provides transportation services between points on waterways"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/water-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/air-transport> a skos:Concept;
  skos:prefLabel "Air transport"@en;
  skos:definition "Movement of people or goods using aircrafts operating in the airspace"@en;
  skos:narrower <https://w3id.org/mobilitydcat-ap/transport-mode/aeroplane>, <https://w3id.org/mobilitydcat-ap/transport-mode/air-taxi>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/air> a skos:Concept;
  skos:prefLabel "Air"@en;
  skos:definition "Movement of people or goods using aircrafts operating in the airspace"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/air-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/aeroplane> a skos:Concept;
  skos:prefLabel "Aeroplane"@en;
  skos:definition "Aircraft for commercial transport of people or goods over medium and long distances"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/air-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/air-taxi> a skos:Concept;
  skos:prefLabel "Air taxi"@en;
  skos:definition "A small passenger aircraft that provides on-demand or scheduled point-to-point air transportation services."@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/air-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/special-transport> a skos:Concept;
  skos:prefLabel "Special transport"@en;
  skos:definition "Transport using cable‑driven or mechanically guided systems"@en;
  skos:narrower <https://w3id.org/mobilitydcat-ap/transport-mode/cableways>, <https://w3id.org/mobilitydcat-ap/transport-mode/elevator>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/escalator>, <https://w3id.org/mobilitydcat-ap/transport-mode/seasonal-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/cableways> a skos:Concept;
  skos:prefLabel "Cableways"@en;
  skos:definition "Funicular railways, cable cars, gondolas, chairlifts, and drag lifts"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/special-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/elevator> a skos:Concept;
  skos:prefLabel "Elevator"@en;
  skos:definition "Vertical transport device that moves passengers or goods in an enclosed cabin."@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/special-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/escalator> a skos:Concept;
  skos:prefLabel "Escalator"@en;
  skos:definition "A continuously moving inclined staircase for transporting passengers."@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/special-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/seasonal-transport> a skos:Concept;
  skos:prefLabel "Seasonal transport"@en;
  skos:definition "Seasonal or terrain‑specific transport (e.g., on snow or ice)"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/special-transport>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/micromobility> a skos:Concept;
  skos:prefLabel "Micromobility"@en;
  skos:definition "Lightweight, usually low‑speed vehicles for short‑distance travel"@en;
  skos:narrower <https://w3id.org/mobilitydcat-ap/transport-mode/bicycle>, <https://w3id.org/mobilitydcat-ap/transport-mode/e-scooter>,
    <https://w3id.org/mobilitydcat-ap/transport-mode/moped>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/bicycle> a skos:Concept;
  skos:prefLabel "Bicycle and E-Bike"@en;
  skos:definition "Human‑powered or electric‑assisted two‑wheel vehicle"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/micromobility>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/e-scooter> a skos:Concept;
  skos:prefLabel "E-Scooter"@en;
  skos:definition "Electrically powered standing scooter"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/micromobility>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/moped> a skos:Concept;
  skos:prefLabel "Moped"@en;
  skos:definition "A lightweight, low-powered motorbike"@en;
  skos:broader <https://w3id.org/mobilitydcat-ap/transport-mode/micromobility>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/pedestrian> a skos:Concept;
  skos:prefLabel "Pedestrian"@en;
  skos:definition "Movement by walking or using mobility aids"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/other> a skos:Concept;
  skos:prefLabel "Other"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/bike-hire> a skos:Concept;
  skos:prefLabel "Bike Hire"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/bicycle>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/bike-sharing> a skos:Concept;
  skos:prefLabel "Bike Sharing"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/bicycle>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/car-hire> a skos:Concept;
  skos:prefLabel "Car Hire"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/car>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/car-pooling> a skos:Concept;
  skos:prefLabel "Car Pooling"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/car>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/car-sharing> a skos:Concept;
  skos:prefLabel "Car Sharing"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/car>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/ride-pooling> a skos:Concept;
  skos:prefLabel "Ride Pooling"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/car>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .

<https://w3id.org/mobilitydcat-ap/transport-mode/taxi> a skos:Concept;
  skos:prefLabel "Taxi"@en;
  owl:deprecated true;
  dct:replacedBy <https://w3id.org/mobilitydcat-ap/transport-mode/car>;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/transport-mode>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/transport-mode> .
