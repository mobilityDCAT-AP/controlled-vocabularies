    <!-- https://w3id.org/mobilitydcat-ap/transport-mode -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mobilitydcat-ap/transport-mode">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mobilitydcat-ap/transport-mode/aeroplane -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mobilitydcat-ap/transport-mode/aeroplane">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode/air-transport"/>
        <skos:definition xml:lang="en">Aircraft for commercial transport of people or goods over medium and long distances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode"/>
        <skos:prefLabel xml:lang="en">Aeroplane</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mobilitydcat-ap/transport-mode/air -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mobilitydcat-ap/transport-mode/air">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:replacedBy rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode/air-transport"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">Movement of people or goods using aircrafts operating in the airspace</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode"/>
        <skos:prefLabel xml:lang="en">Air</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/mobilitydcat-ap/transport-mode/air-taxi -->


    <owl:NamedIndividual rdf:about="https://w3id.org/mobilitydcat-ap/transport-mode/air-taxi">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode/air-transport"/>
        <skos:definition xml:lang="en">A small passenger aircraft that provides on-demand or scheduled point-to-point air transportation services.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode"/>
        <skos:prefLabel xml:lang="en">Air taxi</skos:prefLabel>
    </owl:NamedIndividual>
    


