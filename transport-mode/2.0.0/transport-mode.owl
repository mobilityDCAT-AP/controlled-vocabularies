        <skos:definition xml:lang="en">Movement of people or goods using aircrafts operating in the airspace</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode"/>
        <skos:narrower rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode/aeroplane"/>
        <skos:narrower rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode/air-taxi"/>
        <skos:prefLabel xml:lang="en">Air transport</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode"/>
    </owl:NamedIndividual>
    


