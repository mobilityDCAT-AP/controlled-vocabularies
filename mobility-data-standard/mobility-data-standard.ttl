<https://w3id.org/mobilitydcat-ap/mobility-data-standard> a skos:ConceptScheme;
  a owl:Ontology;
  dct:title "Mobility data standard"@en;
  dct:description "Controlled vocabulary for the mobility data standard adopted by a distribution."@en;
  dct:creator "Mario Scrocca (Cefriel)"@en, "Peter Lubrich (BASt)"@en;
  dct:contributor "Ed Ooms (NDW)"@en, "Petr Bures (TamTam Research)"@en;
  dct:publisher "NAPCORE SubWG4.4"@en;
  owl:versionInfo "1.2.0"@en;
  owl:versionIRI <https://w3id.org/mobilitydcat-ap/mobility-data-standard/1.2.0>;
  owl:priorVersion <https://w3id.org/mobilitydcat-ap/mobility-data-standard/1.1.0>;
  dct:license <https://creativecommons.org/licenses/by/4.0/>;
  <http://purl.org/ontology/bibo/status> "Draft Controlled Vocabulary"@en;
  skos:hasTopConcept <https://w3id.org/mobilitydcat-ap/mobility-data-standard/apds>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/alert-c>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/cds>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/cds-m>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/c-its>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/datex-II>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/dino>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/e-cmr>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/era>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/ertms>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/gbfs>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/gml>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/gtfs>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/gtfs-rt>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/inspire>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/mds>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/netex>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/ocit-o>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/ocit-c>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/ocpi>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/ojp>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/opentnf>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/opra>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/osdm>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/siri>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/tn-its>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/tomp-api>,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/tpegml>, <https://w3id.org/mobilitydcat-ap/mobility-data-standard/other> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/apds> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "APDS"@en;
  skos:definition "Alliance for Parking Data Standards (ADPS)"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/alert-c> a skos:Concept,
    <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "ALERT-C"@en;
  skos:definition "Traffic Message Channel (TMC) ALERT‑C location table standard (CEN/EN 14819‑3)"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/cds> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "CDS"@en;
  skos:definition "Curb Data Specification (Open Mobility Foundation)"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/cds-m> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "CDS-M"@en;
  skos:definition "City Data Specification for Mobility (Open Mobility Foundation)"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/c-its> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "C-ITS"@en;
  skos:definition "Cooperative ITS message standards: CAM (ETSI EN 302 637-2), DENM (ETSI EN 302 637-3), SPAT/MAP (SAE-J2735 and ISO 19091)"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/datex-II> a skos:Concept,
    <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "DATEX II"@en;
  skos:definition "Road Traffic and Travel Data Exchange (DATEX II, CEN/TS 16157)"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/dino> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "DINO"@en;
  skos:definition "DINO exchange format based on the VDV-DIVA exchange format"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/e-cmr> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "e-CMR"@en;
  skos:definition "Electronic Consignment Note under the UNECE CMR Convention"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/era> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "ERA Ontology"@en;
  skos:definition "Ontology of the European Railway Agency (ERA)"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/ertms> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "ERTMS"@en;
  skos:definition "European Rail Traffic Management System"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
  skos:topConceptOf <https://w3id.org/mobilitydcat-ap/mobility-data-standard> .

<https://w3id.org/mobilitydcat-ap/mobility-data-standard/gbfs> a skos:Concept, <https://w3id.org/mobilitydcatap#MobilityDataStandard>;
  skos:prefLabel "GBFS"@en;
  skos:definition "General Bikeshare Feed Specification (MobilityData)"@en;
  skos:inScheme <https://w3id.org/mobilitydcat-ap/mobility-data-standard>;
